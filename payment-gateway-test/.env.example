# Copy to .env and fill in your own values. Never commit the real .env file.

# From My Business -> Business Private Key
GTW_PRIVATE_KEY=
# From My Business -> Business Public Key
GTW_PUBLIC_KEY=
# From My Business -> Add New Business (numeric terminal id)
GTW_TER_NO=

# Optional overrides for the test transaction
GTW_BILL_AMT=10.00
GTW_PRODUCT_NAME=Test Product
GTW_REFERENCE=
GTW_SOURCE_URL=https://example.com/checkout
GTW_RETURN_URL=https://example.com/payment/return
GTW_WEBHOOK_URL=https://example.com/payment/webhook
